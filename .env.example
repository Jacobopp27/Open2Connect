# Export these variables in your shell; the app does not auto-load this file.
HOST=127.0.0.1
PORT=8000
OPEN2CONNECT_DB=data/open2connect.db
ENABLE_VOICE=1
ENABLE_CONNECTIONS=1
ENABLE_DEMO=1
COOKIE_SECURE=0
# Production only, after local verification and provider selection:
# APP_ORIGIN=https://your-approved-domain.example
# COOKIE_SECURE=1
# ENABLE_DEMO=0

# New integrations: explicit local fallback; no remote migration is automatic.
PROFILE_STORE=sqlite
# Set both to enable the real OpenAI interview adapter:
# OPENAI_API_KEY=
# OPENAI_MODEL=your-model-with-structured-outputs
# With PROFILE_STORE=supabase, configure an approved project and SERVER-ONLY key:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=
# Or legacy SUPABASE_SERVICE_ROLE_KEY=
# MCP bridge environment only (one-hour token generated by the app):
# OPEN2CONNECT_APP_URL=http://127.0.0.1:8000
# OPEN2CONNECT_MCP_TOKEN=

# Ambiguous AI agent "Mesa 4" (see backend/modules/ambiguous.py, scripts/ambiguous_setup.py):
# AMBIGUOUS_AGENT_KEY=  # Mesa 4 agent API key; module runs in local/logging-only mode if unset
# AMBIGUOUS_ADMIN_KEY=  # admin key for scripts/ambiguous_setup.py only, not used by the server
# AMBIGUOUS_SHEET_ID=  # id of the Ambiguous sheet used to log suggested connections
# AMBIGUOUS_CHANNEL_ID=  # id of the Ambiguous chat channel for staff notifications
# AMBIGUOUS_ORGANIZER_USER_ID=  # optional: user id to assign tasks created by Mesa 4
# EXA_API_KEY=  # enriquecimiento público (Exa), opcional
